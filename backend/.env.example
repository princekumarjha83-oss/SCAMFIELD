# ScamShield AI - Environment Configuration Example

# Environment Mode: development | staging | production
ENVIRONMENT=development
DEBUG=false

# Database Persistence:
# Default SQLite local database:
DATABASE_URL=sqlite:///./scamshield.db
# PostgreSQL configuration example (uncomment for PostgreSQL persistence):
# DATABASE_URL=postgresql://scamshield_user:securepassword@localhost:5432/scamshield_db

# CORS Allowed Origins (Comma-separated or JSON list):
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Rate Limiting:
RATE_LIMIT_PER_MINUTE=60/minute
SCAN_RATE_LIMIT_PER_MINUTE=30/minute

# Model Artifact Locations:
MODEL_PATH=ml/artifacts/phishing_model.joblib
METRICS_PATH=ml/artifacts/metrics.json
